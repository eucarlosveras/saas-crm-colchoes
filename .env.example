# Copie este arquivo para .env e preencha com as credenciais reais do seu projeto Supabase.
# Nunca commite o .env de verdade — ele já está no .gitignore.

# Usadas pelos scripts Node (dotenv) e como referência
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Só necessária para scripts administrativos locais (ex: listar-lojas.js).
# NUNCA exponha esta chave no front-end — ela ignora as políticas de RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Usadas pelo Vite (import.meta.env) — precisam do prefixo VITE_ para
# ficarem disponíveis ao código do navegador. Use os mesmos valores de
# SUPABASE_URL / SUPABASE_ANON_KEY acima (nunca a service_role key).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
